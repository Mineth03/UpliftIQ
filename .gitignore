# Data (keep directory placeholders; ignore large artifacts)
data/raw/**
data/processed/**
data/synthetic/**
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/synthetic/.gitkeep
!data/artifacts/.gitkeep
data/artifacts/**
!data/artifacts/.gitkeep

# Model / experiment dumps
*.joblib
*.pkl
*.parquet
